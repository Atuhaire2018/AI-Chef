rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny All Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Document Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
        incoming().userId == userId &&
        incoming().userId is string &&
        (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 256)) &&
        (!('displayName' in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 128));
      allow update: if isOwner(userId) &&
        incoming().userId == existing().userId &&
        (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 256)) &&
        (!('displayName' in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 128));
      allow delete: if isOwner(userId);

      // User Saved Recipes Subcollection
      match /savedRecipes/{recipeId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          incoming().userId == userId &&
          incoming().name is string && incoming().name.size() <= 256;
        allow update: if isOwner(userId) &&
          incoming().userId == userId &&
          incoming().name is string && incoming().name.size() <= 256;
        allow delete: if isOwner(userId);
      }

      // User Cart Items Subcollection
      match /cartItems/{itemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          incoming().userId == userId &&
          incoming().name is string && incoming().name.size() <= 256;
        allow update: if isOwner(userId) &&
          incoming().userId == userId &&
          incoming().name is string && incoming().name.size() <= 256;
        allow delete: if isOwner(userId);
      }

      // User Grocery Orders Subcollection
      match /orders/{orderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          incoming().userId == userId &&
          incoming().orderId is string && incoming().orderId.size() <= 128;
        allow update: if isOwner(userId) &&
          incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
